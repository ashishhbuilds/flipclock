<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:transparent;
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
    font-family:Arial, sans-serif;
}

.clock{
    display:flex;
    gap:12px;
}

.flip{
    position:relative;
    width:120px;
    height:140px;
    background:#111;
    border-radius:12px;
    overflow:hidden;
    box-shadow:0 4px 12px rgba(0,0,0,.3);
}

.flip::before{
    content:'';
    position:absolute;
    top:50%;
    left:0;
    width:100%;
    height:2px;
    background:rgba(255,255,255,.15);
    z-index:2;
}

.number{
    width:100%;
    height:100%;
    display:flex;
    justify-content:center;
    align-items:center;
    color:white;
    font-size:72px;
    font-weight:bold;
    transition:transform .4s ease;
}

.label{
    position:absolute;
    bottom:6px;
    left:0;
    width:100%;
    text-align:center;
    font-size:11px;
    color:#aaa;
    letter-spacing:1px;
}

.animate{
    animation:flip .5s ease;
}

@keyframes flip{
    0%{
        transform:rotateX(0deg);
    }
    50%{
        transform:rotateX(-90deg);
    }
    100%{
        transform:rotateX(0deg);
    }
}

@media(max-width:700px){
    .flip{
        width:80px;
        height:100px;
    }

    .number{
        font-size:48px;
    }
}
</style>
</head>

<body>

<div class="clock">

    <div class="flip">
        <div class="number" id="hours">00</div>
        <div class="label">HOURS</div>
    </div>

    <div class="flip">
        <div class="number" id="minutes">00</div>
        <div class="label">MINUTES</div>
    </div>

    <div class="flip">
        <div class="number" id="seconds">00</div>
        <div class="label">SECONDS</div>
    </div>

</div>

<script>
let oldH="", oldM="", oldS="";

function updateClock(){

    const now = new Date();

    const h = String(now.getHours()).padStart(2,'0');
    const m = String(now.getMinutes()).padStart(2,'0');
    const s = String(now.getSeconds()).padStart(2,'0');

    updateUnit("hours", h, oldH);
    updateUnit("minutes", m, oldM);
    updateUnit("seconds", s, oldS);

    oldH=h;
    oldM=m;
    oldS=s;
}

function updateUnit(id,newVal,oldVal){

    const el=document.getElementById(id);

    if(newVal!==oldVal){
        el.classList.remove("animate");
        void el.offsetWidth;
        el.classList.add("animate");
        el.textContent=newVal;
    }
}

updateClock();
setInterval(updateClock,1000);
</script>

</body>
</html>
